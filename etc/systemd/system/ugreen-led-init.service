[Unit]
Description=Load UGREEN LED driver and create I2C device
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'BUS=$(/usr/bin/ugreen-detect-i2c); modprobe led-ugreen 2>/dev/null; sleep 0.5; echo led-ugreen 0x3a > /sys/bus/i2c/devices/i2c-${BUS}/new_device 2>/dev/null; true'
ExecStop=-/usr/sbin/modprobe -r led-ugreen

[Install]
WantedBy=multi-user.target
