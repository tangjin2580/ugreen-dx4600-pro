[Unit]
Description=Load UGREEN LED driver and create I2C device
After=local-fs.target systemd-modules-load.service
Wants=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
# 异常断电冷重启时，SMBus I801 适配器(i2c 总线)尚未被内核/udev 枚举，
# 原逻辑会立即因找不到 0x3a 而退出，导致 LED 设备节点未创建、灯不亮。
# 修复要点:
#  1) 轮询等待 SMBus I801 总线就绪(最多 ~30s)，解决开机竞态；
#  2) 幂等检查看 LED class 设备(power/disk1/netdev)而非 i2c 客户端节点——
#     后者在 modprobe -r 卸载驱动后仍会残留，会导致误判"已就绪"而不重载驱动；
#  3) Restart=on-failure + TimeoutStartSec=120 兜底极慢的磁盘检查/枚举；
#  4) 全部逻辑放进 /usr/local/sbin/ugreen-led-init.sh 脚本文件，
#     由 ExecStart 直接调用——避免在 unit 里写 ExecStart=/bin/sh -c '...'。
#     systemd 对 -c 字符串中"命令替换 $(...) + 循环"的解析有怪异行为：
#     循环里赋值的 BUS 在末尾 echo 处会被吞成空串，导致 "i2c-/new_device" 报错、
#     冷重启后 LED 不亮。独立脚本文件可彻底规避(已实测 BUS=6 正常)。
TimeoutStartSec=120
Restart=on-failure
RestartSec=5
ExecStart=/usr/local/sbin/ugreen-led-init.sh

[Install]
WantedBy=multi-user.target
