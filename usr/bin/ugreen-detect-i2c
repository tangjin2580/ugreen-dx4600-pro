#!/bin/bash
# Auto-detect I2C bus for UGREEN LED controller
SLAVE_ADDR=0x3a
for p in /sys/bus/i2c/devices/i2c-*; do
    b="${p##*/i2c-}"
    n=$(cat "$p/name" 2>/dev/null || echo x)
    case $n in *gmbus*|*drm*|*DP*|*HDMI*|*DDC*) continue ;; esac
    r=$(/usr/local/bin/i2cdetect -y "$b" "$SLAVE_ADDR" "$SLAVE_ADDR" 2>/dev/null) || true
    [ -n "$r" ] && echo "$r" | grep -q UU && { echo "$b"; exit 0; }
done
exit 1
